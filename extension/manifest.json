{
  "manifest_version": 3,
  "name": "iudicium autofill",
  "version": "0.2.0",
  "description": "Fills job applications from your iudicium profiles, one page at a time. You review and submit.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "iudicium autofill (click to open on any application form)" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://iudicium.netlify.app/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
